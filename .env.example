# Local infrastructure
POSTGRES_DB=wispo_cms
POSTGRES_USER=wispo
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://wispo:change-me-locally@localhost:5434/wispo_cms
REDIS_URL=redis://localhost:6380

# Applications
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
# Comma-separated A/AAAA addresses or CNAME targets accepted by DNS verification.
PUBLIC_DOMAIN_TARGETS=
# Exact CMS/API hosts that must never be assigned to a public site.
WISPO_RESERVED_HOSTS=localhost
NEXT_PUBLIC_API_URL=http://localhost:4000/api
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
DB_SYNCHRONIZE=true
DB_SSL=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=Wispo Admin
