    {
      "kind": "system_page",
      "key": "skinova",
      "version": "1",
      "title": "Системная страница Skinova",
      "dataScope": "cms-entity",
      "runtimeContext": [
        "siteSlug",
        "categories",
        "banners",
        "globals",
        "layout"
      ],
      "dataSchemaVersion": "1",
      "dataSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": ["title", "slug", "blocks"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "enum": ["404", "privacy-policy"]
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "type"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": ["hero", "text", "cta"]
                },
                "title": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "buttonLabel": {
                  "type": "string"
                },
                "buttonUrl": {
                  "type": "string"
                },
                "mediaId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "configSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "slots": [
        {
          "key": "homepage_top",
          "title": "Верхняя промо-полоса",
          "placement": "homepage_top",
          "maxItems": 1,
          "allowedChunks": [
            {
              "definitionKey": "skinova-promo-strip",
              "schemaVersion": "1"
            }
          ]
        }
      ]
    }
  ],
  "chunkCategories": [
    {
      "key": "banners",
      "title": "Баннеры",
      "order": 10,
      "iconKey": "banner"
    }
  ],
  "chunkDefinitions": [
    {
      "key": "skinova-promo-strip",
      "schemaVersion": "1",
      "title": "Верхняя промо-полоса",
      "categoryKey": "banners",
      "rendererKey": "skinova-promo-strip",
      "fields": [
        {
          "key": "title",
          "label": "Заголовок",
          "widget": "text",
          "nullable": true,
          "constraints": {
            "maxLength": 200
          }
        },
        {
          "key": "subtitle",
          "label": "Подзаголовок",
          "widget": "textarea",
          "nullable": true,
          "constraints": {
            "maxLength": 300
          }
        },
        {
          "key": "button_text",
          "label": "Текст кнопки",
          "widget": "text",
          "nullable": true,
          "constraints": {
            "maxLength": 80
          }
        },
        {
          "key": "link_url",
          "label": "Ссылка",
          "widget": "text",
          "nullable": true,
          "constraints": {
            "maxLength": 500
          }
        },
        {
          "key": "media_id",
          "label": "Изображение",
          "widget": "image",
          "nullable": true
        },
        {
          "key": "mobile_media_id",
          "label": "Мобильное изображение",
          "widget": "image",
          "nullable": true
        },
        {
          "key": "sort_order",
          "label": "Порядок",
          "widget": "number",
          "required": true,
          "constraints": {
            "min": 0,
            "max": 9999,
            "step": 1
          }
        },
        {
          "key": "is_active",
          "label": "Активен",
          "widget": "boolean",
          "required": true
        }
      ]
    },
