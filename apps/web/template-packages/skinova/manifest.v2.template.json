                "type": ["string", "null"]
              },
              "showPages": {
                "type": "boolean"
              },
              "showArticles": {
                "type": "boolean"
              },
              "ctaLabel": {
                "type": "string"
              },
              "ctaUrl": {
                "type": "string"
              },
              "footerDescription": {
                "type": "string"
              },
              "showContacts": {
                "type": "boolean"
              },
              "showSocials": {
                "type": "boolean"
              },
              "headerTemplateKey": {
                "type": "string"
              },
              "headerTemplateVersion": {
                "type": "string"
