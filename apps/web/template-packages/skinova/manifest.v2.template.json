{
  "manifestVersion": 2,
  "packageId": "skinova-media",
  "packageVersion": "2",
  "title": "Skinova Media",
  "siteType": "media",
  "cmsApi": {
    "minSchemaVersion": "1.2"
  },
  "source": {
    "repository": "https://github.com/ArtemCrazy/wispocms.git"
  },
  "build": {
    "runtimeMode": "embedded-next"
  },
  "templates": [
    {
      "kind": "homepage",
      "key": "skinova-home",
      "version": "1",
      "title": "Главная Skinova",
      "dataScope": "cms-entity",
      "runtimeContext": [
        "siteSlug",
        "categories",
        "articles",
        "banners",
        "globals",
        "layout",
        "mediaBaseUrl",
        "mediaFileSuffix"
      ],
      "dataSchemaVersion": "1",
      "dataSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": ["blocks"],
        "properties": {
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": ["hero", "text", "cta"]
                },
                "title": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "buttonLabel": {
                  "type": "string"
                },
                "buttonUrl": {
                  "type": "string"
                },
                "mediaId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "configSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "slots": [
        {
          "key": "homepage_top",
          "title": "Верхняя промо-полоса",
          "placement": "homepage_top",
          "maxItems": 1,
          "allowedChunks": [
            {
              "definitionKey": "skinova-promo-strip",
              "schemaVersion": "1"
            }
          ]
        },
        {
          "key": "homepage_middle",
          "title": "Баннер консультации",
          "placement": "homepage_middle",
          "maxItems": 1,
          "allowedChunks": [
            {
              "definitionKey": "skinova-consultation-banner",
              "schemaVersion": "1"
            }
          ]
        }
      ]
    },
    {
      "kind": "articles_list",
      "key": "skinova-editorial",
      "version": "1",
      "title": "Лента Skinova",
      "dataScope": "cms-entity",
      "runtimeContext": [
        "siteSlug",
        "homepage",
        "articles",
        "categories",
        "banners",
        "globals",
        "layout",
        "mediaBaseUrl",
        "mediaFileSuffix"
      ],
      "dataSchemaVersion": "1",
      "dataSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "configSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "kind": "article",
      "key": "skinova-article",
      "version": "1",
      "title": "Статья Skinova",
      "dataScope": "cms-entity",
      "runtimeContext": [
        "siteSlug",
        "related",
        "categories",
        "banner",
        "globals",
        "layout",
        "mediaBaseUrl",
        "mediaFileSuffix"
      ],
      "dataSchemaVersion": "1",
      "dataSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": ["title", "slug"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 240
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "excerpt": {
            "type": ["string", "null"],
            "maxLength": 500
          },
          "body": {
            "type": "string"
          },
          "bodyDocument": {
            "type": ["object", "null"],
            "required": ["version", "blocks"],
            "properties": {
              "version": {
                "const": 1
              },
              "blocks": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["id", "type", "text", "level"],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type": {
                          "const": "heading"
                        },
                        "text": {
                          "type": "string"
                        },
                        "level": {
                          "enum": [2, 3, 4]
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["id", "type", "text"],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type": {
                          "const": "paragraph"
                        },
                        "text": {
                          "type": "string"
                        },
                        "href": {
                          "type": ["string", "null"]
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["id", "type", "mediaId"],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type": {
                          "const": "image"
                        },
                        "mediaId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "alt": {
                          "type": "string"
                        },
                        "caption": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["id", "type", "items"],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type": {
                          "enum": ["bullet_list", "numbered_list"]
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["id", "type", "text"],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type": {
                          "const": "quote"
                        },
                        "text": {
                          "type": "string"
                        },
                        "cite": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "categoryId": {
            "type": ["string", "null"]
          },
          "authorId": {
            "type": ["string", "null"]
          },
          "coverMediaId": {
            "type": ["string", "null"]
          },
          "previewMediaId": {
            "type": ["string", "null"]
          },
          "publishedAt": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      },
      "configSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "imageAsset": {
            "type": "string"
          },
          "readMinutes": {
            "type": "number",
            "minimum": 0
          },
          "views": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dateLabel": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "slots": [
        {
          "key": "article_sidebar",
          "title": "Баннер в статье",
          "placement": "article_sidebar",
          "maxItems": 1,
          "allowedChunks": [
            {
              "definitionKey": "skinova-article-sidebar-banner",
              "schemaVersion": "1"
            }
          ]
        }
      ]
    },
    {
      "kind": "category",
      "key": "skinova-category",
      "version": "1",
      "title": "Рубрика Skinova",
      "dataScope": "cms-entity",
      "runtimeContext": [
        "siteSlug",
        "articles",
        "subcategories",
        "globals",
        "layout",
        "mediaBaseUrl",
        "mediaFileSuffix"
      ],
      "dataSchemaVersion": "1",
      "dataSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": ["name", "slug"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": ["string", "null"],
            "maxLength": 10000
          },
          "parentId": {
            "type": ["string", "null"]
          },
          "icon": {
            "type": ["string", "null"],
            "maxLength": 80
          },
          "imageMediaId": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      },
      "configSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "kind": "header",
      "key": "skinova-header",
      "version": "1",
      "title": "Шапка Skinova",
      "dataScope": "cms-entity",
      "runtimeContext": ["siteSlug", "categories", "promo"],
      "dataSchemaVersion": "1",
      "dataSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": ["globals", "layout"],
        "properties": {
          "globals": {
            "type": "object",
            "properties": {
              "companyName": {
                "type": "string"
              },
              "organizationType": {
                "enum": ["ip", "ooo", "self_employed", "other"]
              },
              "legalName": {
                "type": "string"
              },
              "inn": {
                "type": "string"
              },
              "ogrn": {
                "type": "string"
              },
              "legalAddress": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "telegramUrl": {
                "type": ["string", "null"]
              },
              "vkUrl": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": false
          },
          "layout": {
            "type": "object",
            "properties": {
              "logoText": {
                "type": "string"
              },
              "logoMediaId": {
                "type": ["string", "null"]
              },
              "showPages": {
                "type": "boolean"
              },
              "showArticles": {
                "type": "boolean"
              },
              "ctaLabel": {
                "type": "string"
              },
              "ctaUrl": {
                "type": "string"
              },
              "footerDescription": {
                "type": "string"
              },
              "showContacts": {
                "type": "boolean"
              },
              "showSocials": {
                "type": "boolean"
              },
              "headerTemplateKey": {
                "type": "string"
              },
              "headerTemplateVersion": {
                "type": "string"
              },
              "headerTemplateConfig": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              },
              "footerTemplateKey": {
                "type": "string"
              },
              "footerTemplateVersion": {
                "type": "string"
              },
              "footerTemplateConfig": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "configSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "kind": "footer",
      "key": "skinova-footer",
      "version": "1",
      "title": "Подвал Skinova",
      "dataScope": "cms-entity",
      "runtimeContext": ["siteSlug"],
      "dataSchemaVersion": "1",
      "dataSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": ["globals", "layout"],
        "properties": {
          "globals": {
            "type": "object",
            "properties": {
              "companyName": {
                "type": "string"
              },
              "organizationType": {
                "enum": ["ip", "ooo", "self_employed", "other"]
              },
              "legalName": {
                "type": "string"
              },
              "inn": {
                "type": "string"
              },
              "ogrn": {
                "type": "string"
