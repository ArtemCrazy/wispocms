# Local-only Docker environment. Copy to .env.local; never use production secrets here.
POSTGRES_DB=wispo_cms
POSTGRES_USER=wispo
POSTGRES_PASSWORD=wispo-local-postgres
POSTGRES_PORT=5434

JWT_SECRET=wispo-local-jwt-secret-change-only-if-needed
BOOTSTRAP_ADMIN_EMAIL=admin@local.wispo
BOOTSTRAP_ADMIN_PASSWORD=Wispo-Local-2026
BOOTSTRAP_ADMIN_NAME=Wispo Local Admin

WEB_PORT=3300
API_PORT_HOST=4300
REDIS_PORT=6380

# Local release pipeline. Replace the token in .env.local; never commit a real value.
WISPO_RELEASE_TOKEN=replace-with-long-random-local-release-token
WISPO_API_URL=http://127.0.0.1:4300/api
WISPO_SITE_SLUG=skinova
